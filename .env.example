# LLM Providers
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_this_password

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
APP_ENV=development

# Groq AI 
# Groq LLM
GROQ_API_KEY=your_actual_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Hybrid RAGs
# Hybrid RAG
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_GRAPH_WEIGHT=0.5
HYBRID_RRF_K=60
HYBRID_TOP_K=10
HYBRID_VECTOR_TOP_K=10
HYBRID_GRAPH_TOP_K=10
HYBRID_GRAPH_DEPTH=2
HYBRID_MAX_CONTEXT_CHARS=8000

# Router 
ROUTER_ENTITY_DENSITY_THRESHOLD=2
ROUTER_RELATIONSHIP_KEYWORD_WEIGHT=0.35
ROUTER_SEMANTIC_KEYWORD_WEIGHT=0.35
ROUTER_HYBRID_CONFIDENCE_THRESHOLD=0.55
ROUTER_GRAPH_CONFIDENCE_THRESHOLD=0.55
ROUTER_VECTOR_CONFIDENCE_THRESHOLD=0.45
ROUTER_VECTOR_TOP_K=8
ROUTER_GRAPH_DEPTH=2

# LLMOps
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_PREFIX=rag:cache:

# Retry policy
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.5

# Cost tracking (USD per 1M tokens — Groq pricing as of project start)
GROQ_INPUT_COST_PER_1M=0.59
GROQ_OUTPUT_COST_PER_1M=0.79
GEMINI_INPUT_COST_PER_1M=0.075
GEMINI_OUTPUT_COST_PER_1M=0.30